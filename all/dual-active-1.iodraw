        </mxCell>
        <mxCell id="repl-label" value="跨站复制 &amp; 容灾链路" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="650" y="458" width="240" height="30" as="geometry" />
        </mxCell>

        <!-- VM data backfill -->
        <mxCell id="repl-backfill" value="VM 数据回填 (vm-data-backfill.sh)&#xa;1h 分批 export→import · HTTP校验 · forward/reverse&#xa;主站恢复后自动触发 reverse 方向补缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="500" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- N9E cluster -->
        <mxCell id="repl-n9e" value="N9E 集群分片&#xa;共享 MySQL + Redis · 一致性哈希自动分配规则&#xa;每条规则只在一个引擎执行 → 不重复告警&#xa;节点挂→30s心跳超时→规则自动迁移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="580" width="500" height="75" as="geometry" />
        </mxCell>

        <!-- Failover table -->
        <mxCell id="repl-failover" value="故障切换 RTO 一览&#xa;&#xa;MySQL (HAProxy)     ~2s 自动&#xa;VM 查询 (vm-haproxy)  ~2s 自动&#xa;Redis (Sentinel+脚本) ~5s 自动&#xa;告警分片 (N9E)      ~30s 自动&#xa;云采集切换           ~3min (3次防抖)&#xa;VM 数据回填          恢复后自动(reverse)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#333333;fontFamily=IBM Plex Mono;" vertex="1" parent="1">
          <mxGeometry x="520" y="670" width="500" height="170" as="geometry" />
        </mxCell>

