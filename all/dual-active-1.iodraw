          <mxGeometry x="680" y="288" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sync-content" value="sync-to-backup.sh (每日 2am cron)&#xa;├ rsync 分模块同步 (scripts/conf/etc-*)&#xa;├ 两站 compose 一致 · profiles 区分角色&#xa;├ 角色化 conf 排除 sync (mysql/redis/sentinel)&#xa;└ sync 后 sed 修正两站差异 (IP/DSN/对端/haproxy主备)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="520" y="320" width="500" height="90" as="geometry" />
        </mxCell>

